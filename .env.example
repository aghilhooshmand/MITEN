MYSQL_USER=ledger
MYSQL_PASSWORD=ledger
MYSQL_DATABASE=breakthrough_ledger
MYSQL_ROOT_PASSWORD=ledger_root

# static = MIT lists and mappings only (fast, first install)
# full   = also download Yahoo prices and compute scores (slow, needs internet)
# skip   = do not seed
SEED_MODE=static

# Host port for the website
MITEN_PORT=8080
